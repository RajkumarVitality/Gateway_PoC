{
  "name": "appium-typescript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx scripts/run-tests.ts",
    "test:smoke": "node --import tsx scripts/run-tests.ts --suite smoke",
    "test:regression": "node --import tsx scripts/run-tests.ts --suite regression",
    "test:login": "node --import tsx scripts/run-tests.ts",
    "test:android": "cross-env PLATFORM=Android node --import tsx scripts/run-tests.ts",
    "test:ios": "cross-env PLATFORM=iOS node --import tsx scripts/run-tests.ts",
    "test:unit": "node --import tsx --test tests/helpers/*.test.ts",
    "validate:elements": "node --import tsx scripts/validate-elements.ts",
    "typecheck": "tsc --noEmit",
    "secrets:encrypt": "node --import tsx scripts/encrypt-secrets.ts",
    "report:generate": "node --import tsx scripts/generate-reports.ts",
    "report:open": "allure open target/allure-report"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@wdio/allure-reporter": "^9.15.0",
    "@wdio/cli": "^9.15.0",
    "@wdio/globals": "^9.15.0",
    "@wdio/local-runner": "^9.15.0",
    "@wdio/mocha-framework": "^9.15.0",
    "@wdio/spec-reporter": "^9.15.0",
    "allure-commandline": "^2.34.1",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "webdriverio": "^9.15.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "basic-ftp": "6.2.1",
    "serialize-javascript": "7.0.5"
  }
}
